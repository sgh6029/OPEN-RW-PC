plugins {
    id 'java'
    id 'com.github.johnrengelman.shadow' version '7.0.0'
    alias(libs.plugins.android.application) apply false
}

group = 'com.corrodinggames.rts'
version = '1.0-SNAPSHOT'

repositories {
    mavenCentral()
}

dependencies {
    compileOnly fileTree(dir: 'libs', include: ['*.jar'])
}

test {
    useJUnitPlatform()
}
